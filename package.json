		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"jest": "^29.5.0",
		"jest-environment-jsdom": "^30.4.1",
		"obsidian": "^1.4.11",
		"ts-jest": "^29.1.0",
		"tslib": "2.6.2",
		"typescript": "^5.4.0",
		"typescript-eslint": "^8.66.0"
	}
